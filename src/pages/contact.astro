---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Forge">
  <main class="py-24 px-6 md:max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-20">
      
      <div class="md:col-span-5">
        <h1 class="text-7xl font-black uppercase italic tracking-tighter leading-none mb-12">
          Let's <span class="text-orange-600">Forge</span> Something.
        </h1>
        
        <div class="space-y-12">
          <section>
            <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-slate-400 mb-4">Inquiries</h3>
            <p class="text-2xl font-medium tracking-tight">studio@forge-arch.com</p>
            <p class="text-slate-500 mt-1">+44 (0) 20 7946 0123</p>
          </section>

          <section>
            <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-slate-400 mb-4">Location</h3>
            <p class="text-lg leading-relaxed">
              124 Industrial Way<br />
              London, E1 6HU<br />
              United Kingdom
            </p>
          </section>
        </div>
      </div>

      <div class="md:col-span-7">
        <form 
          name="contact" 
          method="POST" 
          data-netlify="true" 
          action="/success"
          class="space-y-10"
        >
          <p class="hidden">
            <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
          </p>
          <input type="hidden" name="form-name" value="contact" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
            <div class="group">
              <label for="name" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 group-focus-within:text-orange-600 transition-colors">Full Name</label>
              <input type="text" id="name" name="name" required class="w-full bg-transparent border-b border-slate-300 py-3 outline-none focus:border-orange-600 transition-colors" />
            </div>
            <div class="group">
              <label for="email" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 group-focus-within:text-orange-600 transition-colors">Email Address</label>
              <input type="email" id="email" name="email" required class="w-full bg-transparent border-b border-slate-300 py-3 outline-none focus:border-orange-600 transition-colors" />
            </div>
          </div>

          <div class="group">
            <label for="subject" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 group-focus-within:text-orange-600 transition-colors">Project Type</label>
            <select id="subject" name="subject" class="w-full bg-transparent border-b border-slate-300 py-3 outline-none focus:border-orange-600 transition-colors appearance-none cursor-pointer">
              <option value="residential">Residential</option>
              <option value="commercial">Commercial</option>
              <option value="interior">Interior Design</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="group">
            <label for="message" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-2 group-focus-within:text-orange-600 transition-colors">Message</label>
            <textarea id="message" name="message" rows="5" required class="w-full bg-transparent border-b border-slate-300 py-3 outline-none focus:border-orange-600 transition-colors resize-none"></textarea>
          </div>

          <button type="submit" class="inline-block bg-slate-900 text-white px-12 py-5 font-bold uppercase tracking-[0.3em] hover:bg-orange-600 transition-all duration-500">
            Submit Brief
          </button>
        </form>
      </div>

    </div>
  </main>
</Layout>