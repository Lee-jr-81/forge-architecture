---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
// Import a studio shot or a portrait if you have one
// import studioImg from "../assets/studio.jpg";
---

<Layout title="About | Forge">
  <main class="">
    
    <section class="grid grid-cols-1 md:grid-cols-12 gap-12 items-end mb-32">
      <div class="md:col-span-8">
        <h1 class="text-5xl md:text-7xl font-black uppercase italic tracking-tighter leading-[0.85]">
          Humanity <br /> <span class="text-orange-600">Through</span> <br /> Structure.
        </h1>
      </div>
      <div class="md:col-span-4">
        <p class="text-sm uppercase tracking-[0.2em] font-bold text-slate-400 mb-4">Established 2024</p>
        <p class="text-lg leading-relaxed text-slate-600">
          Forge is a London-based architectural practice dedicated to the intersection of raw materiality and environmental harmony.
        </p>
      </div>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-32">
      
      
      <div class="md:col-span-5 flex flex-col justify-center">
        <h2 class="text-3xl font-black uppercase italic tracking-tighter mb-8">The Philosophy</h2>
        <div class="space-y-6 text-slate-600 leading-relaxed">
          <p>
            We don't believe in "adding" architecture to a site. We believe in uncovering the architecture that the site demands. Our process—**The Forge**—is an iterative journey of reduction. 
          </p>
          <p>
            By stripping away the superfluous, we arrive at forms that feel permanent, honest, and deeply connected to the people who inhabit them.
          </p>
          <p>
            Every joint, every shadow, and every material transition is a deliberate choice in our pursuit of structural clarity.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-slate-100 pt-24 grid grid-cols-2 md:grid-cols-4 gap-12">
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-2">Projects</h4>
        <p class="text-4xl font-black italic tracking-tighter">24+</p>
      </div>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-2">Awards</h4>
        <p class="text-4xl font-black italic tracking-tighter">08</p>
      </div>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-2">Countries</h4>
        <p class="text-4xl font-black italic tracking-tighter">03</p>
      </div>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-2">Coffee</h4>
        <p class="text-4xl font-black italic tracking-tighter">∞</p>
      </div>
    </section>

  </main>
</Layout>