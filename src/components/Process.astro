---
const steps = [
  {
    num: "01",
    title: "Inquiry",
    desc: "We begin with the site's DNA—studying light, topography, and the specific rhythm of the surrounding context."
  },
  {
    num: "02",
    title: "Forge",
    desc: "The conceptual phase. We hammer out the core structural logic until the form meets the function perfectly."
  },
  {
    num: "03",
    title: "Detail",
    desc: "Architecture is in the joints. We obsess over material transitions to ensure the final build feels permanent and intentional."
  }
];
---

<section class="py-32 border-t border-slate-100 bg-white md:mt-36">
  <div class="w-3/4 mx-auto grid grid-cols-1 md:grid-cols-12 gap-12">
    
    <div class="md:col-span-3">
      <div class="sticky top-32">
        <span class="text-xs font-bold uppercase tracking-[0.4em] text-orange-600">03 / Process</span>
      </div>
    </div>

    <div class="md:col-span-9 grid grid-cols-1 md:grid-cols-3 gap-12">
      {steps.map((step) => (
        <div class="group">
          <div class="text-[10px] font-mono text-slate-400 mb-6 flex items-center gap-2">
            <span class="w-4 h-px bg-slate-200 group-hover:w-8 group-hover:bg-orange-600 transition-all duration-500"></span>
            {step.num}
          </div>
          <h4 class="font-black italic uppercase tracking-tighter text-2xl mb-4">
            {step.title}
          </h4>
          <p class="text-sm text-slate-500 leading-relaxed font-medium">
            {step.desc}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>