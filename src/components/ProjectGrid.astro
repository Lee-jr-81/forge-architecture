---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets'; // Import the Optimizer

const projects: CollectionEntry<'projects'>[] = await getCollection('projects');
---

<div class="w-3/4 mx-auto grid grid-cols-1 md:grid-cols-12 gap-6 md:mt-36">
  
  <div class="md:col-span-8">
    {projects[0] && (
      <div class="h-full flex flex-col">
        <div class="aspect-16/11 overflow-hidden bg-slate-100">
          <Image 
            src={projects[0].data.image} 
            alt={projects[0].data.title}
            class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700"
          />
        </div>
        <div class="mt-4">
          <h3 class="text-xl font-black uppercase italic tracking-tighter">{projects[0].data.title}</h3>
          <p class="text-xs text-slate-500 uppercase tracking-widest">{projects[0].data.category}</p>
        </div>
      </div>
    )}
  </div>

  <div class="md:col-span-4 grid grid-rows-2 gap-6">
    {projects.slice(1, 3).map((project) => (
      <div class="flex flex-col">
        <div class="aspect-16/10 overflow-hidden bg-slate-100">
          <Image 
            src={project.data.image} 
            alt={project.data.title}
            class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700"
          />
        </div>
        <div class="mt-3">
          <h3 class="text-base font-black uppercase italic tracking-tighter">{project.data.title}</h3>
          <p class="text-[10px] text-slate-500 uppercase tracking-widest">{project.data.category}</p>
        </div>
      </div>
    ))}
  </div>

</div>